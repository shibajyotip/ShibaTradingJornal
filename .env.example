# ── Anthropic API Key ─────────────────────────────────────────────────────────
# Required ONLY for the AI Coach tab.
# All other features (journal, analytics, charts) work WITHOUT this key.
#
# Get your free API key at: https://console.anthropic.com
# Copy this file to .env and paste your key below.
#
# IMPORTANT: Never commit your .env file to GitHub (it is already in .gitignore)

VITE_ANTHROPIC_API_KEY=your-api-key-here
